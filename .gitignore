# --- data: never committed. Images are CC-licensed third-party content and the
# corpus runs to several GB. The manifest is the reproducible artefact, not the
# pixels; rerunning the fetchers reconstructs the corpus.
#
# ANCHORED PATH IS LOAD-BEARING: a bare `data/` also matches
# ml/src/birdcam/data/, which would silently drop the entire data layer from
# version control.
/ml/data/

# --- reports: generated, except the directory marker
/ml/reports/*
!/ml/reports/.gitkeep

# --- dashboard runtime state: visits DB + captured media (web/), regenerated
# locally by web/scripts/create_dummy_data.py or written by the feeder later
/var/

# NOTE: config/taxon_cache.json is generated by taxa.py but IS committed --
# it is small, and pinning it keeps runs reproducible across GBIF/iNat backbone
# revisions. See DECISIONS.md. No ignore rule needed; listed here so nobody
# adds one.

# --- model artefacts
*.pt
*.pth
*.onnx
*.npy
*.npz
checkpoints/
runs/
wandb/

# --- python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# --- secrets: API keys live in the environment, never on disk
.env
.env.*
!.env.example

# --- local agent/editor state. Contains a contact email, absolute workstation
# paths and local command permissions. Ignored by this repo rather than relying
# on a personal global gitignore, which a fresh clone would not have.
.claude/settings.local.json
