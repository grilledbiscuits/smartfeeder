# --- data: never committed. Images are CC-licensed third-party content and the
# corpus runs to several GB. The manifest is the reproducible artefact, not the
# pixels; rerunning the fetchers reconstructs the corpus.
#
# LEADING SLASH IS LOAD-BEARING: a bare `data/` also matches src/birdcam/data/,
# which would silently drop the entire data layer from version control.
/data/

# --- reports: generated, except the directory marker
/reports/*
!/reports/.gitkeep

# NOTE: config/taxon_cache.json is generated by taxa.py but IS committed --
# it is small, and pinning it keeps runs reproducible across GBIF/iNat backbone
# revisions. See DECISIONS.md. No ignore rule needed; listed here so nobody
# adds one.

# --- model artefacts
*.pt
*.pth
*.onnx
*.npy
*.npz
checkpoints/
runs/
wandb/

# --- python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# --- secrets: API keys live in the environment, never on disk
.env
