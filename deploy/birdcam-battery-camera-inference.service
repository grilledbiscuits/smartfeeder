[Unit]
Description=Bird feeder battery camera and inference test (one clip every 30 seconds)
After=local-fs.target birdcam-capture.service birdcam-battery-inference.service
Conflicts=birdcam-capture.service birdcam-battery-inference.service
RequiresMountsFor=/home/grilledbiscuits/soak-20261012

[Service]
Type=simple
User=grilledbiscuits
WorkingDirectory=/home/grilledbiscuits/soak-20261012
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smartfeeder/.venv/bin/python /home/grilledbiscuits/soak-20261012/deploy/soak_camera_inference.py --config /home/grilledbiscuits/soak-20261012/capture/config/capture.yaml --out /home/grilledbiscuits/soak-20261012/ml/reports/battery-camera-inference-next --interval 30
StandardOutput=append:/home/grilledbiscuits/soak-20261012/ml/reports/battery-camera-inference-next/runner.log
StandardError=inherit
Restart=no

[Install]
WantedBy=multi-user.target
