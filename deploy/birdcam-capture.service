# systemd unit for the feeder capture service.
#
# Install:
#   sudo cp deploy/birdcam-capture.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now birdcam-capture
#
# Adjust User, WorkingDirectory and ExecStart to match where the repo is
# checked out. The paths below assume /opt/smartfeeder; see capture/README.md.

[Unit]
Description=Bird feeder motion-triggered capture and classification
Documentation=file:/opt/smartfeeder/capture/README.md
# Publication is same-host (SQLite + var/media), so no network is required to
# start. This only orders the unit after the local filesystems are up.
After=local-fs.target
RequiresMountsFor=/opt/smartfeeder
# Do not let repeated crashes hammer the card. After 5 failures in 10 minutes
# systemd gives up; `systemctl reset-failed` clears it. These belong in [Unit]:
# systemd ignores StartLimitIntervalSec in [Service] and logs "Unknown key" on
# every reload, which left the rate limit silently inactive.
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
User=birdcam
Group=birdcam
# video -> /dev/video* and the camera; gpio -> /dev/gpiochip* for the PIR, and
# for the ToF too: Blinka's `board` imports RPi.GPIO for its pin table before it
# will hand over an I2C bus. i2c -> /dev/i2c-1, which the VL53L1X speaks on.
# Without all three the service starts and then cannot claim its hardware.
SupplementaryGroups=video gpio i2c

# NOT the repo root, and NOT anywhere under it. lgpio (reached via RPi.GPIO,
# reached via Blinka) creates a `.lgd-nfy*` notify file in the CURRENT DIRECTORY
# on import, and /opt/smartfeeder is root-owned so the service cannot write
# there. That failure is silent in the PIR path -- gpiozero catches it and falls
# back to its experimental polling pin factory -- but fatal in the ToF path,
# where `import board` raises outright.
#
# systemd creates and tears down this directory, owned by User=, so nothing in
# the repo tree has to be writable.
#
# Do NOT point this at /opt/smartfeeder/var: `python -m capture` finds the
# package on sys.path[0], which is the CWD, and var/ contains the spool
# directory var/capture/. Python picks that up as a namespace package and dies
# with "No module named capture.__main__". Hence the explicit PYTHONPATH below,
# which is now the only thing making the package importable.
RuntimeDirectory=birdcam-capture
WorkingDirectory=/run/birdcam-capture
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/smartfeeder
# Optional: secrets referenced as ${VAR} from capture.yaml. The leading '-'
# means a missing file is not an error.
EnvironmentFile=-/etc/default/birdcam-capture

ExecStart=/opt/smartfeeder/.venv/bin/python -m capture \
    --config /opt/smartfeeder/capture/config/capture.yaml

# Restart on any exit, including a clean one: a capture service that has
# stopped is a feeder that is not being watched.
Restart=always
RestartSec=10
# Give an in-flight recording and its publish attempt time to finish. The
# service handles SIGTERM and drains before exiting.
KillSignal=SIGTERM
TimeoutStopSec=45

# --- hardening ---------------------------------------------------------------
# Deliberately NOT PrivateDevices=yes: that hides /dev/video* and
# /dev/gpiochip*, and the service would start and then fail to find its
# hardware -- a confusing failure with a non-obvious cause.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# The only path the service writes: clips, the log, and the dashboard's
# database and media.
ReadWritePaths=/opt/smartfeeder/var

[Install]
WantedBy=multi-user.target
